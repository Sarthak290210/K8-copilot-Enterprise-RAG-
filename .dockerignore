# Secrets — pass at runtime (env_file in compose), never bake into the image
.env
.env.*

# Local environments and caches
.venv
__pycache__/
*.py[oc]
.ruff_cache
.mypy_cache
.pytest_cache

# VCS / editor / tooling
.git
.gitignore
.vscode
.idea
.claude

# Not needed at runtime
eval/results
tests
*.md
Dockerfile
docker-compose.yml

# Dataset: kept on disk, mounted read-only by compose instead of copied into the image
seed/docs/noisy_data
