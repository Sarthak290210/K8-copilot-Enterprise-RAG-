# Copy to .env and fill in real values:  cp .env.example .env
# Required: CEREBRAS_API_KEY, DATABASE_URL, JWT_SECRET. Everything else has a default.
# POSTGRES_PASSWORD (used by docker-compose) must match the password in DATABASE_URL.

# === LLM & Embeddings ===
CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL_ANSWER=gpt-oss-120b
LLM_MODEL_GRADER=gpt-oss-120b
EVAL_JUDGE_MODEL=qwen-3.8-27b
EVAL_RELEVANCY_STRICTNESS=3
LLM_REASONING_EFFORT=low

EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

HF_TOKEN=your-huggingface-token

# === Vector DB ===
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=documents

# === Postgres ===
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/adv_rag

# === Cache (Upstash) ===
UPSTASH_REDIS_URL=https://your-instance.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token
CACHE_TTL_EMBEDDINGS=604800        # 7 days
CACHE_TTL_RAG=3600                 # 1 hour
CACHE_TTL_SQL_GEN=86400            # 24 hours
CACHE_TTL_SQL_RESULT=900           # 15 min
CACHE_TTL_INTENT=86400             # 24 hours

# === Doc dedup ===
STORAGE_BACKEND=local              # or "s3"
S3_CACHE_BUCKET=adv-rag-cache
AWS_REGION=us-east-1

# === Web search ===
TAVILY_API_KEY=your-tavily-api-key

# === Auth ===
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars   # app refuses to start if < 32
JWT_EXPIRATION_MINUTES=60

# === Seed users (scripts/seed_db.py) — a user is skipped if its password is unset ===
SEED_ADMIN_PASSWORD=change-me
SEED_ANALYST_PASSWORD=change-me

# === Rate limit + budget ===
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_TOKENS_PER_USER_DAILY=100000
AUTH_LOGIN_RATE_LIMIT_PER_MIN=5
AUTH_REGISTER_RATE_LIMIT_PER_HOUR=3

# === Input restructuring ===
MAX_INPUT_TOKENS=3000
RESERVED_CONTEXT_TOKENS=1000
RESERVED_OUTPUT_TOKENS=1000

# === Security thresholds ===
PROMPT_INJECTION_THRESHOLD=0.75
TOXICITY_THRESHOLD=0.75
OUTPUT_TOXICITY_THRESHOLD=0.5
MAX_VALIDATION_RETRIES=2

# === Retrieval defaults ===
HYDE_NUM_HYPOTHESES=3
HYDE_ENABLED_BY_DEFAULT=false
HYBRID_SEARCH_ENABLED=true
RRF_K=60
RERANKER_BACKEND=local             # or "voyage"
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MAX_LENGTH=256
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_MODEL=rerank-2.5
RERANKER_INITIAL_TOP_K=20
RERANKING_ENABLED_BY_DEFAULT=true
CRAG_RELEVANCE_THRESHOLD=0.7
CRAG_AMBIGUOUS_THRESHOLD=0.5
CRAG_ENABLED_BY_DEFAULT=true
REFLECTION_MIN_SCORE=0.85
MAX_REFLECTION_RETRIES=2
SELF_REFLECTIVE_ENABLED_BY_DEFAULT=false

# === Vanna ===
VANNA_MODEL=openai/gpt-oss-120b
VANNA_TEMPERATURE=0.0
VANNA_SEED=42

# === Logging ===
LOG_JSON=false                     # true in prod
LOG_LEVEL=INFO

# === Docker Compose (Postgres container; must match DATABASE_URL) ===
POSTGRES_PASSWORD=change-me

# === Server (optional; defaults shown) ===
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
